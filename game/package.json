{
  "name": "the-last-weather",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "The Last Weather: a text-first sci-fi survival RPG prototype (React + TypeScript + Vite + Capacitor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs && node scripts/sync-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "qa": "tsx scripts/qa.mjs",
    "check": "npm run validate && npm test && npm run build && npm run qa",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:assets": "node scripts/app-icons.mjs && capacitor-assets generate --android --ios --assetPath resources --iconBackgroundColor \"#0b121d\" --iconBackgroundColorDark \"#0b121d\" --splashBackgroundColor \"#0b121d\" --splashBackgroundColorDark \"#0b121d\"",
    "images": "node scripts/app-icons.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
